{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "crons": [
    { "path": "/api/poll", "schedule": "*/15 * * * *" },
    { "path": "/api/poll/downtowndry", "schedule": "*/15 * * * *" },
    { "path": "/api/poll/ebikelocal", "schedule": "*/15 * * * *" }
  ],
  "rewrites": [
    {
      "source": "/api/poll/:brand",
      "destination": "/api/poll?brand=:brand"
    }
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 120,
      "includeFiles": "assets/images/**"
    }
  }
}